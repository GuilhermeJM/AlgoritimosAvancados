"""
============== DIJKSTRA ==============
"""
from heapq import heappush, heappop
def dijkstra(grafo, inicio):
#inicio= = nó inicial
    n = len(grafo)
    dist = [float('inf')] * n
#define a distancia inicial como infinito
    dist[inicio] = 0
    heap = [(0,inicio)]

    while heap:
        distancia_atual, no = heappop(heap)
        if distancia_atual > dist[no]:
            continue
        for vizinho, peso in grafo:
            nova_dist = dist[no] + peso
            if nova_dist <dist[vizinho]:
                dist[vizinho] = nova_dist
                heappush(heap,(nova_dist,vizinho))
    return dist
    

"""
============== UNION-FIND ==============
"""
def find(x, pais):
    if pais[x] < 0:
        return x
    pais[x] = find(pais[x],pais)
    return pais[x]

def union(a,b,pais):
    raiz_a = find(a,pais)
    raiz_b = find(b,pais)
    
    if raiz_a == raiz_b:
        return False
    
    if pais[raiz_b] < pais[raiz_a]:
        raiz_a, raiz_b = raiz_b, raiz_a
    
    pais[raiz_a]+= pais[raiz_b]
    pais[raiz_b] = raiz_a

    return True

def tamanho(x,pais):
    raiz = find(x,pais)
    return -pais[raiz]


"""
============== KRUSKAL ==============
"""

def kruskal(n, arestas):
    arestas.sort()
    pais = [-1] * (n-1)
    custo_total = 0
    arvore = [] 
    for peso, u, v in arestas:
        if union(u,v,peso):
            custo_total += peso
            arvore.append((u,v,peso))
            if len(arvore) == n-1:
                break
    if len(arvore) != n-1:
        return False
    return arvore, custo_total

